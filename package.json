{
  "name": "crosstab",
  "version": "0.4.0",
  "description": "Firefox extension with an overview of all open tabs across windows.",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:ext": "web-ext lint",
    "start": "web-ext run",
    "build": "web-ext build --overwrite-dest",
    "sign": "web-ext sign --channel=listed --approval-timeout=0 --amo-metadata=amo-metadata.json",
    "screenshots": "npm run build && node scripts/screenshots.js",
    "listing": "node scripts/amo-listing.js",
    "typecheck": "tsc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run lint:ext && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "selenium-webdriver": "^4.54.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0"
  },
  "webExt": {
    "ignoreFiles": [
      "test",
      "*.md",
      "release-please-config.json",
      "amo-metadata.json",
      "package.json",
      "package-lock.json",
      "eslint.config.js",
      "tsconfig.json",
      "**/*.d.ts",
      "listing",
      "scripts"
    ]
  }
}
