{
  "manifest_version": 3,
  "name": "Crosstab",
  "version": "0.1.0",
  "description": "Overview of all open tabs across windows: search, group, and sort them, find duplicates, and close them.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["tabs", "tabGroups", "sessions"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Open Crosstab",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crosstab@caugner.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
