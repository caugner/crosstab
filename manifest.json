{
  "manifest_version": 3,
  "name": "Crosstab",
  "version": "0.4.0",
  "description": "All open tabs from every window on one page: find the one you need, close forgotten tabs and duplicates, and reorganise tabs across windows.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "sessions"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Open Crosstab",
    "default_icon": "icons/icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "crosstab@caugner.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
